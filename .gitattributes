# Handle line endings automatically for files detected as text
# and force them to be normalized to LF on checkin.
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and force LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.html text eol=lf
*.sql text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Denote all files that are truly binary and should not be modified
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
